# --- WeNearBy Environment Configuration ---
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# --- Firebase Configuration (Required) ---
# Get these values from Firebase Console > Project Settings > General
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Google Maps API Key (Optional - only if using Google provider) ---
# Get from Google Cloud Console > APIs & Services > Credentials
# Required only if EXPO_PUBLIC_GEOCODING_PROVIDER=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Geocoding Provider (Required) ---
# Options:
#   - "google": Google Maps Geocoding API (requires GOOGLE_MAPS_API_KEY)
#   - "nominatim": OpenStreetMap Nominatim (free, no key required)
# Default: nominatim
EXPO_PUBLIC_GEOCODING_PROVIDER=nominatim

# --- Service Layer Selection ---
# Use Firebase backend (true) or Mock services (false)
EXPO_PUBLIC_USE_FIREBASE=true

# --- Feature Flags ---
EXPO_PUBLIC_FEATURE_VENDOR_APPROVAL_FLOW=true
EXPO_PUBLIC_FEATURE_ORDER_INTENT=true

# --- Default Configuration ---
EXPO_PUBLIC_DEFAULT_COVERAGE_KM=5
EXPO_PUBLIC_LOG_LEVEL=info

# --- Optional: Supabase (for future analytics/storage) ---
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
